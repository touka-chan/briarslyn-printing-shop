# Widget Preview related
.widget_preview/

# FlutterFire / Firebase — generated by `flutterfire configure`.
# These contain project-specific keys and MUST NOT be committed.
# `flutterfire configure` regenerates them on each developer machine.
# Note: `mobile_app/lib/firebase_options.dart` itself IS committed
# (it holds only public config values like apiKey + appId + projectId
# — the same as `web/.env.local`). The placeholder values inside
# (`REPLACE_ME`) are overwritten by `flutterfire configure`.
**/android/app/google-services.json
**/android/app/google-services.plist
**/ios/Runner/GoogleService-Info.plist
**/macos/Runner/GoogleService-Info.plist
**/windows/firebase_options.cpp
**/linux/firebase_options.cc

# Service account JSON (ESP32 firmware key, Cloud Function keys, etc.).
# The public Firebase web app config is in `web/.env.local` (gitignored
# there) and the FlutterFire config in `mobile_app/lib/firebase_options.dart`
# is committed. The service account JSON's `private_key` and
# `client_email` must NEVER be committed anywhere.
**/service-account*.json
**/serviceAccount*.json
**/secrets.h

