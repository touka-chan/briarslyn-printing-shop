rules_version = '2';

// PrintFlow - Firestore Security Rules
// Deployed via `firebase deploy --only firestore:rules`
// See SETUP_FIREBASE.md for the role matrix and the ESP32 service-account
// story (rfid_events is service-account-only - no user can fake a check-out).

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // myRole() is safe to call when the caller has no profile doc yet:
    // `get()` on a non-existent path throws PERMISSION_DENIED, so we wrap
    // it in `exists()` and return an empty string in that case. This lets
    // a brand-new user self-create their profile doc without needing an
    // already-existing admin doc to authorize them.
    function myRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : '';
    }

    function isOwner()    { return myRole() == 'Owner'; }
    function isAdmin()    { return isOwner() || myRole() == 'Admin'; }
    function isCashier()  { return isAdmin() || myRole() == 'POS_Cashier'; }
    function isProduction() { return isAdmin() || myRole() == 'Production Staff'; }

    // ---- users/{uid} ----
    // Three ways a user/{uid} doc can be created:
    //   1. Self-create (you create your own profile; `uid` == auth.uid).
    //   2. First-user bootstrap (the caller has no profile doc yet, so
    //      we can't read their role to authorize them - let them in).
    //   3. Owner/Admin creates a profile for a teammate.
    // After the doc exists, the normal self/Admin rules apply for updates.
    match /users/{uid} {
      allow read: if isSignedIn();
      // Forgot-password existence check runs while SIGNED OUT. Allow
      // single-doc list queries only (limit <= 1, e.g. email lookup):
      // enough to confirm an account exists, too narrow to dump the
      // roster. Accepted tradeoff — the reset UI must confirm existence.
      allow list: if request.query.limit != null && request.query.limit <= 1;
      allow create: if isSignedIn() && (
        request.auth.uid == uid
        || !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || isAdmin()
      );
      allow update: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ---- employees/{employeeId} ----
    // HR records. Any signed-in user can read (the Employees page is
    // a directory). Only Owner/Admin can write. Employees are *not* sign-in
    // accounts - see /users for that.
    match /employees/{employeeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---- orders/{orderId} ----
    // Any signed-in user can read.
    // Cashier/Owner/Admin can create.
    // Cashier/Owner/Admin can update general fields.
    // Production Staff + Admin can update `status` (the production flow).
    // No one can delete (use a `cancelled` status instead).
    match /orders/{orderId} {
      allow read: if isSignedIn();
      allow create: if isCashier();
      // Production flow keys are snake_case - they must match exactly what
      // the apps write: updateOrderStatus (status/started_at/completed_at),
      // completeOrder (production_notes/actual_minutes), and the auto-deduct
      // transaction (stock_deducted/deducted_at). A camelCase list here
      // silently denies every Production-Staff status update.
      allow update: if isCashier() ||
                       (isProduction() &&
                        request.resource.data.diff(resource.data)
                          .affectedKeys()
                          .hasOnly(['status', 'started_at', 'completed_at', 'production_notes', 'actual_minutes', 'stock_deducted', 'deducted_at']));
      allow delete: if false;
    }

    // ---- inventory/{materialVariantId} ----
    // Any signed-in user can read.
    // Production Staff + Admin can write (stock adjustments, ROP edits,
    // new variant creation).
    match /inventory/{materialVariantId} {
      allow read: if isSignedIn();
      allow write: if isProduction();
    }

    // ---- sensors/{sensorId} ----
    // Any signed-in user can read sensor status.
    // Production Staff + Admin can toggle online state.
    match /sensors/{sensorId} {
      allow read: if isSignedIn();
      allow write: if isProduction();
    }

    // ---- bom/{normalizedItemType} ----
    // Bill of materials: order item_type - material lines consumed per
    // unit when an order enters production (auto-deduct engine).
    // Any signed-in user can read (the engine needs it); only
    // Owner/Admin can change recipes.
    match /bom/{bomId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---- usage_events/{auto} ----
    // Immutable audit log of EVERY stock movement: auto-deducts
    // (confirmed orders), manual logs (wastage/sample/correction) and
    // RFID/station entries (stock-in taps, check-ins). The single source
    // of truth behind the forecast model - one entry per movement, so
    // auto-deduct + manual + tap can never double-count each other.
    match /usage_events/{eventId} {
      allow read: if isSignedIn();
      allow create: if isProduction();
      allow update, delete: if false;
    }

    // ---- rfid_events/{auto} ----
    // **Service-account only.** The ESP32 firmware uses a service-account key
    // to write check-out events. No signed-in user (cashier, owner, anyone)
    // can read from or write to this collection via the client SDK.
    // The web and mobile apps read rfid_events via a server-side proxy
    // (a Cloud Function) or via the service account on the ESP32's behalf.
    //
    // For the demo without a Cloud Function yet, this rule can be relaxed
    // to `allow read: if isSignedIn();` - the data is still write-protected.
    match /rfid_events/{eventId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false; // service-account only
    }

    // ---- audit_logs/{auto} ----
    // Immutable, append-only trail. Any signed-in staff member's client
    // may APPEND one well-formed entry per action it performs (the actor
    // must be the caller - no forging other users' entries). Nobody -
    // including Owner - can update or delete entries, so history cannot
    // be rewritten from any client. Reads are Owner-only (page + gate).
    match /audit_logs/{entryId} {
      allow read: if isOwner();
      allow create: if isSignedIn()
        && request.resource.data.actor_uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'actor_uid', 'actor_email', 'actor_name', 'actor_role',
          'action', 'module', 'record_id', 'record_label',
          'old_value', 'new_value', 'source', 'ip', 'created_at'
        ])
        && request.resource.data.actor_uid is string
        && request.resource.data.action is string
        && request.resource.data.module is string
        && request.resource.data.record_id is string;
      allow update, delete: if false;
    }

    // ---- otp_codes/{uid} ----
    // One-time codes for profile-edit confirmations (5-minute TTL,
    // single-use, max 5 attempts). Written and verified ONLY by the Apps
    // Script service account (Admin SDK bypasses rules) - no client can
    // ever read a code out of the database, so possessing the code
    // proves access to the registered inbox.
    match /otp_codes/{docId} {
      allow read, write: if false;
    }

    // ---- counters/{counterId} ----
    // Sequence counters behind human-friendly ids (orders -> ORD-0001).
    // Order creation reads + bumps `counters/orders` in the SAME
    // transaction that writes the order, so only cashier-tier roles may
    // touch it. Deletes are denied - resetting would re-issue ids.
    match /counters/{counterId} {
      allow read: if isSignedIn();
      allow create, update: if isCashier() && counterId == 'orders';
      allow delete: if false;
    }

    // ---- everything else ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
