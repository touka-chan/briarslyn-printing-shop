import type { Metadata } from "next";
import { Suspense } from "react";
import "./globals.css";
import { AuthGate } from "@/components/auth/AuthGate";

export const metadata: Metadata = {
 title: "PrintFlow — Brialyns Art Sign",
 description:
  "Integrated POS, IoT inventory, and order-workflow for Brialyns Art Sign.",
};

const themeBootstrap = `
(function(){
  try {
    var t = localStorage.getItem("printflow-theme");
    if (t === "dark" || (!t && window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
      document.documentElement.classList.add("dark");
    }
  } catch(e) {}
})();
`;

/**
 * Static pre-render fallback for the auth gate.
 *
 * Must be plain markup with zero navigation hooks. During `next build`
 * with `output: "export"`, the internal `/_global-error` route prerenders
 * this root layout without a request context — anything calling
 * `usePathname()` / `useRouter()` outside a Suspense boundary crashes the
 * build with `Invariant: Expected workStore to be initialized`.
 * The Suspense boundary below lets the prerenderer emit this fallback as
 * static HTML and hydrate the real gate on the client.
 */
function AuthLoadingFallback() {
 return (
  <div
   style={{
    minHeight: "100vh",
    display: "flex",
    alignItems: "center",
    justifyContent: "center",
    fontFamily: "Segoe UI, system-ui, -apple-system, sans-serif",
    background: "#fbf9f4",
    color: "#0b1314",
   }}
  >
   <p style={{ fontSize: 14, opacity: 0.7 }}>Loading PrintFlow…</p>
  </div>
 );
}

export default function RootLayout({
 children,
}: {
 children: React.ReactNode;
}) {
 return (
  <html
   lang="en"
   className="h-full antialiased"
   suppressHydrationWarning
  >
   <head>
    {/* Without an explicit viewport, mobile browsers fall back to a 980px
        desktop canvas and the entire layout renders zoomed-in. width=device-width
        + initial-scale=1 is the only correct pair for a responsive app. */}
    <meta
     name="viewport"
     content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="theme-color" content="#00535b" />
    <script dangerouslySetInnerHTML={{ __html: themeBootstrap }} />
   </head>
   <body className="min-h-full flex flex-col">
    <Suspense fallback={<AuthLoadingFallback />}>
     <AuthGate>{children}</AuthGate>
    </Suspense>
   </body>
  </html>
 );
}