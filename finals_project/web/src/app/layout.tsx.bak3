import type { Metadata } from "next";
import dynamic from "next/dynamic";
import "./globals.css";

export const metadata: Metadata = {
 title: "PrintFlow — Brialyns Art Sign",
 description:
  "Integrated POS, IoT inventory, and order-workflow for Brialyns Art Sign.",
};

const themeBootstrap = `
(function(){
  try {
    var t = localStorage.getItem("printflow-theme");
    if (t === "dark" || (!t && window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
      document.documentElement.classList.add("dark");
    }
  } catch(e) {}
})();
`;

/**
 * Static pre-render fallback for the auth gate (also used as the
 * `loading` placeholder for the client-only gate below).
 *
 * Must stay plain markup with zero navigation hooks.
 */
function AuthLoadingFallback() {
 return (
  <div
   style={{
    minHeight: "100vh",
    display: "flex",
    alignItems: "center",
    justifyContent: "center",
    fontFamily: "Segoe UI, system-ui, -apple-system, sans-serif",
    background: "#fbf9f4",
    color: "#0b1314",
   }}
  >
   <p style={{ fontSize: 14, opacity: 0.7 }}>Loading PrintFlow…</p>
  </div>
 );
}

/**
 * The auth gate reads `usePathname()` / `useRouter()`, which cannot run
 * during a static-export prerender (no request context — the build dies
 * with `Invariant: Expected workStore to be initialized` on
 * `/_global-error`). It is also the exact component that froze hydration
 * when wrapped in `<Suspense>`: the prerendered boundary state could not
 * be resumed by the client, leaving every page stuck on "Loading…".
 *
 * `ssr: false` fixes both: the prerender only ever emits the static
 * `loading` fallback above (byte-identical on server and first client
 * render, so hydration is trivially consistent), and the real gate mounts
 * fresh in the browser with a live router.
 */
const AuthGateNoSSR = dynamic(
 () => import("@/components/auth/AuthGate").then((m) => m.AuthGate),
 { ssr: false, loading: () => <AuthLoadingFallback /> },
);

export default function RootLayout({
 children,
}: {
 children: React.ReactNode;
}) {
 return (
  <html
   lang="en"
   className="h-full antialiased"
   suppressHydrationWarning
  >
   <head>
    <script dangerouslySetInnerHTML={{ __html: themeBootstrap }} />
   </head>
   <body className="min-h-full flex flex-col">
    <AuthGateNoSSR>{children}</AuthGateNoSSR>
   </body>
  </html>
 );
}